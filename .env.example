# Copy to .env and fill in. Set the same variables in Cloudflare Pages (Production + Preview).

# Video/image CDN origin (no trailing slash)
VITE_CDN_URL=https://cdn.example.com

# EmailJS (emailjs.com → Email Services / Email Templates / Account → API keys).
# The public key is meant to be public: restrict it to the site's domain in the EmailJS dashboard.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx

# Absolute site URL (no trailing slash): canonical links, Open Graph, JSON-LD and sitemap.xml
VITE_SITE_URL=https://ali-portfolio-vue.pages.dev

# Plausible analytics domain. Leave empty to disable tracking.
VITE_PLAUSIBLE_DOMAIN=
